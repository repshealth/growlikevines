{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glv-reset-app",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/app", "/login", "/start"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growlikevines",
      "database_id": "4a397150-56d5-4d6c-ae20-cefb863e3516"
    }
  ],
  // Not secret, so they live here (dashboard plain-text variables are replaced on every deploy).
  // RESEND_API_KEY, STRIPE_WEBHOOK_SECRET and STRIPE_PAYMENT_LINK are Secrets set in the Cloudflare dashboard.
  "vars": {
    "EMAIL_FROM": "Project Reset <hello@projectresetglv.co.uk>",
    "NOTIFY_EMAIL": "ellis@growlikevines.com"
  },
  "observability": { "enabled": true }
}
