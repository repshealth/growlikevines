{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glv-reset-app",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growlikevines",
      "database_id": "4a397150-56d5-4d6c-ae20-cefb863e3516"
    }
  ],
  "observability": { "enabled": true }
}
